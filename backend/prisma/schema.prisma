generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  account  Account?
  sessions Session[]
}

model Account {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int  @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id     Int    @id @default(autoincrement())
  userId Int
  token  String @unique

  user User @relation(fields: [userId], references: [id])
}